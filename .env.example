# ===============================================
# MOEDA BOT - CONFIGURAÇÃO DE AMBIENTE
# ===============================================

# Chave de API do Google Gemini (Google AI Studio)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Integração Notion
# Obtenha o Internal Integration Token em: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_seu_token_notion_aqui

# ID da Base de Dados "Despesas" no Notion
# Copie do link da base: https://notion.so/workspace/<NOTION_DESPESAS_DB_ID>?v=...
NOTION_DESPESAS_DB_ID=seu_database_id_aqui

# ID do Grupo do WhatsApp (Opcional - Restringe o bot exclusivamente a este grupo)
# Exemplo: 120363024829283746@g.us
# Dica: Deixe em branco inicialmente; o bot exibirá o remoteJid no terminal ao receber a primeira mensagem.
ALLOWED_GROUP_ID=

